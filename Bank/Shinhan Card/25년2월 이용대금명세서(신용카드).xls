		                   <td style="mso-number-format:&quot;\@&quot;;" data-bind-text="excelInfo.sncSeq">0002</td>	<!-- C2022100664191_HPG 엑셀 다운로드 이용대금 명세서 문구 수정 요청의 件 -->
